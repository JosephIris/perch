<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- RID comes from the host build's -r flag (win-x64 from Perch.csproj,
         osx-arm64 from Perch.Mac.csproj). -->
    <!-- Single-file, self-contained so the EXE drops next to Perch.exe
         without needing a separate DLL set or a runtime install. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>perch</AssemblyName>
    <RootNamespace>PerchCli</RootNamespace>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Perch</RootNamespace>
    <AssemblyName>Perch</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Perch.Core\Perch.Core.csproj" />
  </ItemGroup>

  <!-- Stage the built web bundle next to the exe, mirroring Perch.csproj. -->
  <ItemGroup>
    <Content Include="..\Perch\wwwroot\**\*.*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             Condition="Exists('$(MSBuildThisFileDirectory)..\Perch\wwwroot')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <WebSource Include="$(MSBuildThisFileDirectory)..\web\src\**\*.*" />
    <WebSource Include="$(MSBuildThisFileDirectory)..\web\index.html" />
    <WebSource Include="$(MSBuildThisFileDirectory)..\web\esbuild.config.mjs" />
  </ItemGroup>
  <!-- `dotnet build -p:SkipWebBundle=true` compiles the host without touching
       the page: for host-only test runs while the page is mid-edit (a
       broken import would otherwise fail the C# build too). Never set in CI. -->
  <Target Name="BundleWeb" BeforeTargets="BeforeBuild"
          Condition="'$(SkipWebBundle)' != 'true'"
          Inputs="@(WebSource)"
          Outputs="$(MSBuildThisFileDirectory)..\Perch\wwwroot\app.js">
    <Exec Command="npm --prefix &quot;$(MSBuildThisFileDirectory)..\web&quot; run build"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- `dotnet publish` ignores tools/ from BuildPerchCli's OutDir, so we
       republish into PublishDir/tools for the .app bundle to pick up. -->
  <Target Name="PublishPerchCli" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\..\tools\perch-cli\perch-cli.csproj&quot; -c $(Configuration) -r osx-arm64 --self-contained true -p:PublishSingleFile=true -p:InvariantGlobalization=true -o &quot;$(PublishDir)tools&quot; --nologo -v q" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\tools\perch-cli\claude;$(MSBuildThisFileDirectory)..\..\tools\perch-cli\codex" DestinationFolder="$(PublishDir)tools" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(PublishDir)tools/claude&quot; &quot;$(PublishDir)tools/codex&quot; &quot;$(PublishDir)tools/perch&quot;" />
  </Target>

  <!-- perch CLI + claude/codex shims, published for the host's RID. -->
  <Target Name="BuildPerchCli" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\..\tools\perch-cli\perch-cli.csproj&quot; -c $(Configuration) -r osx-arm64 --self-contained true -p:PublishSingleFile=true -p:InvariantGlobalization=true -o &quot;$(OutDir)tools&quot; --nologo -v q" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\tools\perch-cli\claude;$(MSBuildThisFileDirectory)..\..\tools\perch-cli\codex" DestinationFolder="$(OutDir)tools" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(OutDir)tools/claude&quot; &quot;$(OutDir)tools/codex&quot; &quot;$(OutDir)tools/perch&quot;" />
  </Target>

</Project>
